# このファイルをコピーして .env を作り、値を入れる。
#   cp .env.example .env
# .env は .gitignore に入れてあるのでコミットされない。
#
# 読み込み方（実行の直前に1回）:
#   set -a && source .env && set +a
#   python3 make.py drafts/megaliths_v1.txt --name megaliths --generate-images

OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Claude Code の「API credentials」に登録した場合は、鍵ではなく下記を立てる。
# 鍵は代理が要求に付けるので、こちらには渡らない（より安全）。
# OPENAI_VIA_PROXY=1
# ELEVENLABS_VIA_PROXY=1
